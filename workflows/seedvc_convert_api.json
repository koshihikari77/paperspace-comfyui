{
  "source": {
    "class_type": "LoadAudio",
    "inputs": {"audio": "source.wav"}
  },
  "reference": {
    "class_type": "LoadAudio",
    "inputs": {"audio": "reference.wav"}
  },
  "convert": {
    "class_type": "SeedVCRun",
    "inputs": {
      "source_audio": ["source", 0],
      "ref_audio": ["reference", 0],
      "steps": 25,
      "speed": 1.0,
      "inference_cfg_rate": 0.7,
      "f0_condition": true,
      "auto_f0_adjust": true,
      "pitch_shift": 0,
      "unload_model": false
    }
  },
  "save": {
    "class_type": "SaveAudio",
    "inputs": {"audio": ["convert", 0], "filename_prefix": "seedvc/convert"}
  }
}
